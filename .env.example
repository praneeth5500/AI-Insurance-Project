# Copy to .env and fill in locally. Never commit a real .env.
# No real credentials belong in this file or in the repository.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# local | preview | staging | production-beta   (09_AWS_DEPLOYMENT.md §4)
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (docker-compose provides this database locally)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://insurance:insurance@localhost:5432/insurance_local

# ---------------------------------------------------------------------------
# Backend HTTP
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# The design-system reference page is developer documentation, not product.
# It is served only when this is `local`; anywhere else the route 404s.
NEXT_PUBLIC_APP_ENV=local

# ---------------------------------------------------------------------------
# Beta auth
# ---------------------------------------------------------------------------
# Where magic links point. Must match the address the app is served from.
FRONTEND_BASE_URL=http://localhost:3000

# Invite-only: nobody can sign in until an address is listed here and
# `make seed-allowlist` has been run. Comma-separated.
BETA_ALLOWLIST_EMAILS=

# Session cookie. Set SESSION_COOKIE_DOMAIN in deployed environments when the
# API and app sit on different subdomains of one site (e.g. .example.com).
SESSION_COOKIE_NAME=insurance_session
SESSION_COOKIE_DOMAIN=

# Lifetimes. Neither is fixed by the specification — see docs/PHASE_2_NOTES.md.
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Feature availability
# ---------------------------------------------------------------------------
# A destination is advertised only when it actually works, so these stay false
# until the phase that builds the flow turns them on. Motor must not be
# enabled until the health engine and motor data are ready
# (docs/13_DECISIONS_AND_OPEN_ITEMS.md open item 8).
FEATURE_HEALTH_RECOMMENDATION=true    # questionnaire is live; matching is Phase 9
FEATURE_MOTOR_RECOMMENDATION=false    # after health is stable
FEATURE_POLICY_DECODER=false          # Phases 10-13

# ---------------------------------------------------------------------------
# Uploaded policy documents (Phases 10-13)
# ---------------------------------------------------------------------------
# Local development writes uploads under the developer's own home directory.
# Deployed environments need a private object store; none is chosen yet, so
# the API refuses to use local disk outside APP_ENV=local rather than writing
# private documents somewhere shared.
UPLOAD_STORAGE_DIR=

# Upload limits. None of these numbers are fixed by the specification — see
# docs/SPEC_ISSUES.md. They are refusal thresholds, not targets.
MAX_UPLOAD_BYTES=20971520      # 20 MB
MAX_DOCUMENT_PAGES=400
MAX_DOCUMENTS_PER_POLICY=5

# Requests slower than this are logged at WARNING.
SLOW_REQUEST_THRESHOLD_MS=1000

# Serve clearly-labelled synthetic modules on the returning-user home so the
# layout can be reviewed before real data exists. Local and preview only —
# the API refuses to start with this on in staging or production-beta.
HOME_DEMO_DATA=false

# ---------------------------------------------------------------------------
# Email delivery: local development writes magic links to
# backend/.dev-magic-links.log. A real provider adapter (AWS SES fits the
# stack) must be implemented before any deployed environment can send invites.
#
# Still open in docs/13_DECISIONS_AND_OPEN_ITEMS.md, gaining settings in later
# phases: object storage (Phase 10), queue (Phase 10), LLM provider (Phase 9),
# OCR provider (Phase 11).
# ---------------------------------------------------------------------------
