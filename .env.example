# Copy to .env and fill in locally. Never commit a real .env.
# No real credentials belong in this file or in the repository.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# local | preview | staging | production-beta   (09_AWS_DEPLOYMENT.md §4)
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (docker-compose provides this database locally)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://insurance:insurance@localhost:5432/insurance_local

# ---------------------------------------------------------------------------
# Backend HTTP
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Not configured in Phase 0 — these remain open items in
# docs/13_DECISIONS_AND_OPEN_ITEMS.md and gain settings in later phases:
#   auth/email provider (Phase 2), object storage (Phase 10),
#   queue (Phase 10), LLM provider (Phase 9), OCR provider (Phase 11).
# ---------------------------------------------------------------------------
